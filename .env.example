# ==============================================================================
# ENVIRONMENT VARIABLES
# ==============================================================================

# Express server port
PORT=4000

# CORS — frontend origin (React dev server)
FRONTEND_URL=http://localhost:5173

# Supabase REST endpoint (e.g. https://your-project-ref.supabase.co)
SUPABASE_URL=

# Supabase Service Role Key (Backend only! Bypasses RLS — NEVER expose to React/Vite)
SUPABASE_SERVICE_ROLE_KEY=

# Cron Authentication
CRON_SECRET=replace-with-a-long-random-secret

# SendGrid Email Alerts
SENDGRID_API_KEY=your_sendgrid_api_key_here
ALERT_EMAIL_FROM=alerts@yourdomain.com